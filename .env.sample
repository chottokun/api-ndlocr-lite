# NDLOCR-Lite API Configuration

# Port for the API server (used by run_load_tests.sh)
# API_PORT=8001

# Security Limits
# Maximum size for uploaded files (in bytes). Default: 10485760 (10MB)
MAX_IMAGE_SIZE=10485760

# Maximum size for request body (in bytes). Default: 15728640 (15MB)
MAX_BODY_SIZE=15728640

# Maximum number of pixels allowed in an image. Default: 100000000 (100MP)
MAX_PIXELS=100000000

# Enable Tate-Chu-Yoko (TCY) support (true or false)
ENABLE_TCY=false

# 異体字包摂（旧字体→新字体変換）を有効化 (true または false、初期値: false)
ENABLE_CHARACTER_INCLUSION=false

# 構造化 Markdown 出力（見出し・段落結合・表埋め込み）を有効化 (true または false、初期値: false)
ENABLE_RICH_MARKDOWN=false

# 表構造化（TableCenterNet による HTML / Markdown 表出力）を有効化 (true または false、初期値: false)
ENABLE_TABLE_STRUCTURE=false

# Device to use for OCR (cpu or cuda)
DEVICE=cpu
